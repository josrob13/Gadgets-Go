    BodyAnimation: 
    FaceExpression: 
  voiceClip: {fileID: 0}
  questionText: "Fij\xE1ndote en el rostro de Marcos, \xBFCu\xE1l es su emoci\xF3n
    principal?"
  options:
  - "Est\xE1 muy triste y tiene ganas de llorar"
